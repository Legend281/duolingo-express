PORT=5000

# Generate both of these fresh for a real deployment — never reuse the sample values below.
#
# To set/change the admin password:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR-NEW-PASSWORD', 12))"
# then paste the output as ADMIN_PASSWORD_HASH.
#
# To generate a session secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash-see-instructions-above
SESSION_SECRET=replace-with-a-random-64-char-hex-string

# Leave unset (or "false") on a real/production deployment. Only set to "true" for a fresh
# local/demo install where you WANT the sample "Randy's Tacoma" shipment, sample quotes, and
# a sample document created automatically the first time the database is empty. On a live
# site this must stay unset — otherwise deleting every shipment (even by accident) would
# silently repopulate this fake demo data in place of your real, now-lost records.
SEED_DEMO_DATA=false
