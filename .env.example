PORT=5000

# Generate both of these fresh for a real deployment — never reuse the sample values below.
#
# To set/change the admin password:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR-NEW-PASSWORD', 12))"
# then paste the output as ADMIN_PASSWORD_HASH.
#
# To generate a session secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash-see-instructions-above
SESSION_SECRET=replace-with-a-random-64-char-hex-string

# Leave unset (or "false") on a real/production deployment. Only set to "true" for a fresh
# local/demo install where you WANT the sample "Randy's Tacoma" shipment, sample quotes, and
# a sample document created automatically the first time the database is empty. On a live
# site this must stay unset — otherwise deleting every shipment (even by accident) would
# silently repopulate this fake demo data in place of your real, now-lost records.
SEED_DEMO_DATA=false

# CRITICAL on a real deployment: if your host wipes files that aren't tracked by git on every
# deploy (some do, as part of a clean checkout), the database silently disappears the moment
# you push new code — since it MUST be gitignored (a live database can't be committed).
# If your host provides any storage path described as persistent / surviving redeploys, set
# DB_PATH to a .db file inside it (e.g. /home/yourapp/persistent-storage/duolingo_express.db).
# Leave unset for local dev, or once you've confirmed your host does NOT wipe untracked files.
# DB_PATH=/absolute/path/to/persistent-storage/duolingo_express.db

# Automatic database backups (see server/backup.ts). A backup is taken on startup if the newest
# one is older than the interval, then on that schedule; the oldest are deleted beyond the keep
# count. IMPORTANT: point BACKUP_DIR at storage your host keeps across redeploys (same reason
# as DB_PATH above) — a backup sitting in a folder a deploy wipes gets wiped with it. Admins can
# also download a copy any time from Settings > Data & Backups; keep one off the server.
# BACKUP_DIR=/absolute/path/to/persistent-storage/backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14

# Time zone for times the server writes (event times, "last updated"), as an IANA zone name.
# Defaults to the company's headquarters zone. Times an admin types with a label (ET/CT/MT/PT)
# keep that label. See src/utils/dates.ts.
# BUSINESS_TIMEZONE=America/New_York

# Content Security Policy (see server/csp.ts for the list of allowed outside services).
# Set to "true" to make browsers only REPORT violations (in the console) instead of blocking —
# a safe way to trial a change, e.g. after adding a new outside service. Leave unset normally.
# CSP_REPORT_ONLY=true
